# MySQL production settings (Locaweb-hosted MySQL 5.6, shared with SIG-2000)
MYSQL_HOST_PROD=
MYSQL_USER_PROD=
MYSQL_PASSWORD_PROD=
MYSQL_DATABASE_PROD=

# MySQL local settings (used when DJANGO_DB_TARGET is not "prod")
MYSQL_HOST_LOCAL=127.0.0.1
MYSQL_USER_LOCAL=
MYSQL_PASSWORD_LOCAL=
MYSQL_DATABASE_LOCAL=

# Downloads API auth (shared-secret roles, not per-account)
DOWNLOAD_USER_PASSWORD=
DOWNLOAD_ADMIN_PASSWORD=

# SMTP email configuration (contact form)
SMTP_SERVER=
SMTP_PORT=587
EMAIL_REMETENTE=
EMAIL_SENHA=
EMAIL_DESTINATARIO=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_TARGET=local
DJANGO_CSRF_TRUSTED_ORIGINS=
